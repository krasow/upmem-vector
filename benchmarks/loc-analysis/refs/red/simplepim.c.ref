static void rescatter_to_existing(const char* table_id, void* elements,
                                  simplepim_management_t* mgmt) {
    table_host_t* t = lookup_table(table_id, mgmt);
    uint32_t len_per_dpu_in_byte = t->end - t->start;
    struct dpu_set_t dpu;
    int i;
    DPU_FOREACH(mgmt->set, dpu, i) {
        DPU_ASSERT(dpu_prepare_xfer(
            dpu, &((char*)elements)[(uint64_t)i * len_per_dpu_in_byte]));
    }
    DPU_ASSERT(dpu_push_xfer(mgmt->set, DPU_XFER_TO_DPU,
                             DPU_MRAM_HEAP_POINTER_NAME, t->start,
                             len_per_dpu_in_byte, DPU_XFER_DEFAULT));
}

void map_to_val_func(void* input, void* output, uint32_t* key) {
    *key = 0;
    *(T*)output = *(T*)input;
}

void combine_func(void* dest, void* src) {
    *(T*)dest += *(T*)src;
}

T run_reduction(T* A, simplepim_management_t* mgmt, handle_t* handle) {
    simplepim_scatter("t1", A, nr_elements, sizeof(T), mgmt);
    rescatter_to_existing("t1", A, mgmt);
    T* res = table_gen_red("t1", "t2", sizeof(T), 1, handle, mgmt, 0);
    return *res;
}
